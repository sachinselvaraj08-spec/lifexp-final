# ============================================================
# LifeXP Environment Configuration Template
# Copy this file to .env.local (frontend) or .env (backend).
# NEVER commit real secrets. This file contains PLACEHOLDERS ONLY.
# ============================================================

# ── Frontend (apps/frontend/.env.local) ─────────────────────

# Firebase Web SDK (get these from Firebase Console → Project Settings → Your Apps)
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id

# Backend API URL (set to your production backend once deployed, e.g. Railway/Render)
# For local dev: http://localhost:5000
# For production: https://your-lifexp-backend.up.railway.app
NEXT_PUBLIC_BACKEND_URL=https://your-backend-url.example.com

# ── Backend (apps/backend/.env) ──────────────────────────────

# Express server port
PORT=5000

# Frontend URL (for CORS allow-list)
# Local: http://localhost:3000
# Production: https://your-lifexp-app.vercel.app
FRONTEND_URL=https://your-lifexp-app.vercel.app

# Path to Firebase Admin service account JSON (NEVER commit the actual file)
FIREBASE_SERVICE_ACCOUNT_PATH=./src/config/service-account.json
