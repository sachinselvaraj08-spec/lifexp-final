# ============================================================
# LifeXP Monorepo — .gitignore
# ============================================================

# ── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ── Environment / Secrets (NEVER commit these) ───────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# Firebase service-account private key (backend only)
service-account.json
**/service-account.json
**/service-account*.json

# ── Next.js build output ─────────────────────────────────────
apps/frontend/.next/
apps/frontend/out/

# ── TypeScript incremental build info ───────────────────────
*.tsbuildinfo

# ── Backend compiled output ──────────────────────────────────
apps/backend/dist/

# ── Shared package compiled output ───────────────────────────
# Keep packages/shared/dist/ committed so Vercel can resolve
# @lifexp/shared without a separate build step.
# If you prefer to build it in CI, uncomment the next line:
# packages/shared/dist/

# ── Logs ─────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# ── OS files ─────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini

# ── Editor / IDE ─────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo

# ── Vercel ───────────────────────────────────────────────────
.vercel

# ── Docker ───────────────────────────────────────────────────
# (keep docker-compose.yml committed for local dev)
